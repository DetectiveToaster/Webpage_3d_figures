DATABASE_URL=postgresql://postgres:change-me@db:5432/store
SECRET_KEY=change-me-use-a-long-random-value
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Optional runtime mode. Set to production in deployed environments.
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Upload limit. 157286400 bytes = 150 MiB, enough for typical 20-120 MiB STL files.
MAX_UPLOAD_BYTES=157286400

# Manual checkout and rough shipping.
BIZUM_PHONE=
BANK_TRANSFER_IBAN=
BANK_TRANSFER_BENEFICIARY=
MANUAL_PAYMENT_INSTRUCTIONS=
MANUAL_SHIPPING_DEFAULT_COST=5.00
MANUAL_SHIPPING_PER_ITEM_COST=0.00
MANUAL_SHIPPING_PER_KG_COST=0.00
MANUAL_SHIPPING_FREE_MIN_SUBTOTAL=0

# Optional integrations.
ENABLE_PAYPAL=false
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
PAYPAL_RETURN_URL=http://localhost:3000/success
PAYPAL_CANCEL_URL=http://localhost:3000/cancel

ENABLE_CARRIER_SHIPPING=false
SHIPPING_HTTP_TIMEOUT=10
CORREOS_API_URL=
CORREOS_API_KEY=
UPS_API_URL=
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
DHL_API_URL=
DHL_API_KEY=
DHL_API_SECRET=
